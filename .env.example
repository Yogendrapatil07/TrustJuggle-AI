# TrustJuggle AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-trustjuggle-2026
DATABASE_URL=sqlite:///trustjuggle.db

# Risk Engine Thresholds
RISK_THRESHOLD_LOW=35
RISK_THRESHOLD_HIGH=70
